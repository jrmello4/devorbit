{
  "name": "devorbit",
  "version": "1.0.44",
  "description": "Developer Workspace Hub & AI Launcher",
  "author": "DevOrbit contributors",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "dist": "npm run build && electron-builder --publish never",
    "start": "electron .",
    "verify:ui": "electron scripts/verify-ui.cjs",
    "verify:runtime": "electron scripts/verify-runtime.cjs",
    "smoke:ipc": "electron scripts/smoke-ipc.cjs",
    "smoke:package": "node scripts/smoke-package.cjs",
    "verify:bridge": "vitest run tests/agent-bridge.test.ts tests/agent-bridge-event.test.ts tests/agent-bridge-runtime.test.ts tests/process-runner.test.ts tests/ripgrep-indexer.test.ts",
    "verify:bridge:e2e": "electron scripts/verify-bridge.cjs",
    "mcp": "node scripts/devorbit-mcp.cjs",
    "audit:tokens": "node scripts/validate-tokens.cjs",
    "audit:repository": "node scripts/audit-repository.cjs",
    "release:check": "node scripts/release-check.cjs",
    "verify:all": "npm run typecheck && npm run typecheck:test && npm test -- --run && npm run lint && npm run build && npm run audit:tokens && npm run audit:repository && npm run release:check && npm run verify:bridge",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.22.0",
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.1"
  }
}
