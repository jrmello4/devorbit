{
  "appId": "com.devorbit.desktop",
  "productName": "DevOrbit",
  "artifactName": "DevOrbit-${version}-${arch}.${ext}",
  "asar": true,
  "npmRebuild": false,
  "asarUnpack": [
    "node_modules/node-pty/**/*"
  ],
  "electronUpdaterCompatibility": ">=2.16",
  "publish": {
    "provider": "github",
    "owner": "jrmello4",
    "repo": "devorbit",
    "releaseType": "release"
  },
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    { "from": "devorbit.cmd", "to": "devorbit.cmd" },
    { "from": "devorbit-mcp.cmd", "to": "devorbit-mcp.cmd" },
    { "from": "scripts/devorbit-bridge.cjs", "to": "scripts/devorbit-bridge.cjs" },
    { "from": "scripts/devorbit-mcp.cjs", "to": "scripts/devorbit-mcp.cjs" }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "portable": {
    "artifactName": "DevOrbit-${version}-portable.${ext}"
  }
}
